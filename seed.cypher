ame: "Joining datasets", domain: "Data science", level: 3, description: "Join tables on keys and validate row counts and unmatched records.", resourceUrl: "https://pandas.pydata.org/docs/getting_started/intro_tutorials/", resourceTitle: "pandas Getting Started"}, {id: "data-extension-05", name: "Categorical variables", domain: "Data science", level: 3, description: "Inspect category frequency and encode categories without losing their meaning.", resourceUrl: "https://pandas.pydata.org/docs/getting_started/intro_tutorials/", resourceTitle: "pandas Getting Started"}, {id: "data-extension-06", name: "Sampling methods", domain: "Data science", level: 3, description: "Select a sample that represents the population and understand selection bias.", resourceUrl: "https://pandas.pydata.org/docs/getting_started/intro_tutorials/", resourceTitle: "pandas Getting Started"}, {id: "data-extension-07", name: "Probability distributions", domain: "Data science", level: 3, description: "Use distribution shape to describe variation and reason about likely values.", resourceUrl: "https://pandas.pydata.org/docs/getting_started/intro_tutorials/", resourceTitle: "pandas Getting Started"}, {id: "data-extension-08", name: "Variance and standard deviation", domain: "Data science", level: 3, description: "Quantify spread around a mean and interpret the units of the result.", resourceUrl: "https://pandas.pydata.org/docs/getting_started/intro_tutorials/", resourceTitle: "pandas Getting Started"}, {id: "data-extension-09", name: "Correlation and confounding", domain: "Data science", level: 3, description: "Measure association while avoiding causal claims from correlation alone.", resourceUrl: "https://pandas.pydata.org/docs/getting_started/intro_tutorials/", resourceTitle: "pandas Getting Started"}, {id: "data-extension-10", name: "Hypothesis tests", domain: "Data science", level: 5, description: "State a testable hypothesis and interpret a test statistic with its assumptions.", resourceUrl: "https://pandas.pydata.org/docs/getting_started/intro_tutorials/", resourceTitle: "pandas Getting Started"}, {id: "data-extension-11", name: "Confidence intervals", domain: "Data science", level: 5, description: "Describe uncertainty around an estimate using a confidence interval.", resourceUrl: "https://pandas.pydata.org/docs/getting_started/intro_tutorials/", resourceTitle: "pandas Getting Started"}, {id: "data-extension-12", name: "Experimental design", domain: "Data science", level: 5, description: "Plan controls, outcomes, and assignment before collecting experimental data.", resourceUrl: "https://pandas.pydata.org/docs/getting_started/intro_tutorials/", resourceTitle: "pandas Getting Started"}, {id: "data-extension-13", name: "Train, validation, and test sets", domain: "Data science", level: 5, description: "Separate data roles to tune models without leaking final test information.", resourceUrl: "https://pandas.pydata.org/docs/getting_started/intro_tutorials/", resourceTitle: "pandas Getting Started"}, {id: "data-extension-14", name: "Data leakage", domain: "Data science", level: 5, description: "Identify information unavailable at prediction time that can inflate evaluation scores.", resourceUrl: "https://pandas.pydata.org/docs/getting_started/intro_tutorials/", resourceTitle: "pandas Getting Started"}, {id: "data-extension-15", name: "Classification metrics", domain: "Data science", level: 5, description: "Choose precision, recall, or F1 based on the cost of different errors.", resourceUrl: "https://pandas.pydata.org/docs/getting_started/intro_tutorials/", resourceTitle: "pandas Getting Started"}, {id: "data-extension-16", name: "Regression metrics", domain: "Data science", level: 5, description: "Compare regression errors with metrics whose scale fits the target and use case.", resourceUrl: "https://pandas.pydata.org/docs/getting_started/intro_tutorials/", resourceTitle: "pandas Getting Started"}, {id: "data-extension-17", name: "Cross-validation", domain: "Data science", level: 5, description: "Estimate model stability by repeating evaluation across training and validation folds.", resourceUrl: "https://pandas.pydata.org/docs/getting_started/intro_tutorials/", resourceTitle: "pandas Getting Started"}, {id: "data-extension-18", name: "Feature engineering", domain: "Data science", level: 6, description: "Create useful model inputs from domain knowledge and validate their assumptions.", resourceUrl: "https://pandas.pydata.org/docs/getting_started/intro_tutorials/", resourceTitle: "pandas Getting Started"}, {id: "data-extension-19", name: "Reproducible analysis", domain: "Data science", level: 6, description: "Record data versions, parameters, and code so results can be reproduced.", resourceUrl: "https://pandas.pydata.org/docs/getting_started/intro_tutorials/", resourceTitle: "pandas Getting Started"}, {id: "data-extension-20", name: "Communicating findings", domain: "Data science", level: 6, description: "Present a result with its evidence, uncertainty, limitations, and practical meaning.", resourceUrl: "https://pandas.pydata.org/docs/getting_started/intro_tutorials/", resourceTitle: "pandas Getting Started"}, {id: "data-extension-21", name: "Unsupervised learning", domain: "Data science", level: 6, description: "Explore unlabeled data with clustering while checking whether groups are useful.", resourceUrl: "https://pandas.pydata.org/docs/getting_started/intro_tutorials/", resourceTitle: "pandas Getting Started"}, {id: "data-extension-22", name: "Model interpretation", domain: "Data science", level: 6, description: "Explain model behavior with suitable interpretation methods and known limitations.", resourceUrl: "https://pandas.pydata.org/docs/getting_started/intro_tutorials/", resourceTitle: "pandas Getting Started"}, {id: "data-extension-23", name: "Time-series foundations", domain: "Data science", level: 6, description: "Respect temporal order when describing and evaluating time-dependent data.", resourceUrl: "https://pandas.pydata.org/docs/getting_started/intro_tutorials/", resourceTitle: "pandas Getting Started"}, {id: "data-extension-24", name: "Responsible data practice", domain: "Data science", level: 6, description: "Review consent, privacy, representativeness, and potential downstream harms.", resourceUrl: "https://pandas.pydata.org/docs/getting_started/intro_tutorials/", resourceTitle: "pandas Getting Started"}, {id: "data-extension-25", name: "Analysis portfolio project", domain: "Data science", level: 6, description: "Deliver a reproducible analysis with a clear question, evidence, and limitations.", resourceUrl: "https://pandas.pydata.org/docs/getting_started/intro_tutorials/", resourceTitle: "pandas Getting Started"}, {id: "neo4j-extension-01", name: "Node labels and identity", domain: "Neo4j", level: 2, description: "Use labels to describe node types and stable identifiers to match entities.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "neo4j-extension-02", name: "Relationship direction and type", domain: "Neo4j", level: 2, description: "Choose relationship types and directions that express domain meaning.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "neo4j-extension-03", name: "Property design", domain: "Neo4j", level: 2, description: "Store attributes as properties and keep relationship facts on the relationship when appropriate.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "neo4j-extension-04", name: "Graph cardinality", domain: "Neo4j", level: 2, description: "Reason about one-to-one, one-to-many, and many-to-many connections in a graph.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "neo4j-extension-05", name: "Modeling optional connections", domain: "Neo4j", level: 2, description: "Represent missing or optional relationships without inventing placeholder entities.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "neo4j-extension-06", name: "Schema constraints", domain: "Neo4j", level: 2, description: "Use uniqueness and existence constraints to protect important data invariants.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "neo4j-extension-07", name: "Indexes and lookup speed", domain: "Neo4j", level: 2, description: "Index properties used for selective starting points in graph queries.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "neo4j-extension-08", name: "CSV import planning", domain: "Neo4j", level: 2, description: "Map source columns to labels, identifiers, and relationships before importing data.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "neo4j-extension-09", name: "LOAD CSV patterns", domain: "Neo4j", level: 2, description: "Use LOAD CSV with headers and batched processing for repeatable data imports.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "neo4j-extension-10", name: "Transactions", domain: "Neo4j", level: 4, description: "Group related graph writes so they succeed or fail together.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "neo4j-extension-11", name: "Neo4j drivers", domain: "Neo4j", level: 4, description: "Create a driver, verify connectivity, and close sessions and drivers reliably.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "neo4j-extension-12", name: "Managed transactions", domain: "Neo4j", level: 4, description: "Use managed transaction functions to handle retries and transaction boundaries.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "neo4j-extension-13", name: "Connection pooling", domain: "Neo4j", level: 4, description: "Reuse drivers and connection pools instead of creating a new connection per query.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "neo4j-extension-14", name: "Full-text indexes", domain: "Neo4j", level: 4, description: "Use a full-text index for text matching and understand when it differs from exact lookup.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "neo4j-extension-15", name: "Vector indexes", domain: "Neo4j", level: 4, description: "Store embeddings and query a vector index when semantic similarity is required.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "neo4j-extension-16", name: "Query plans and profiling", domain: "Neo4j", level: 4, description: "Inspect query plans to find expensive scans, expansions, and sorting operations.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "neo4j-extension-17", name: "Backups and recovery", domain: "Neo4j", level: 4, description: "Plan backups and test restore procedures against a recovery objective.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "neo4j-extension-18", name: "Database users and roles", domain: "Neo4j", level: 6, description: "Grant least-privilege roles that match the application's database operations.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "neo4j-extension-19", name: "Aura instance operations", domain: "Neo4j", level: 6, description: "Monitor instance status, connection details, and resource usage in Aura.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "neo4j-extension-20", name: "Schema evolution", domain: "Neo4j", level: 6, description: "Change graph structure incrementally while keeping existing application data compatible.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "neo4j-extension-21", name: "Graph algorithms overview", domain: "Neo4j", level: 6, description: "Choose a graph algorithm only when its assumptions fit the analysis question.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "neo4j-extension-22", name: "Operational monitoring", domain: "Neo4j", level: 6, description: "Use database metrics and logs to investigate workload and service health.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "neo4j-extension-23", name: "Role-based access design", domain: "Neo4j", level: 6, description: "Separate application permissions according to the least-privilege principle.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "neo4j-extension-24", name: "Import validation and reconciliation", domain: "Neo4j", level: 6, description: "Compare source and graph counts to detect incomplete or duplicated imports.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "neo4j-extension-25", name: "Production readiness review", domain: "Neo4j", level: 6, description: "Review data model, access, backups, observability, and recovery before release.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "cypher-extension-01", name: "Pattern variables", domain: "Cypher", level: 3, description: "Bind nodes and relationships to variables so their properties can be returned.", resourceUrl: "https://neo4j.com/docs/cypher-manual/current/", resourceTitle: "Cypher Manual"}, {id: "cypher-extension-02", name: "Property predicates", domain: "Cypher", level: 3, description: "Filter matched patterns using precise property comparisons and boolean conditions.", resourceUrl: "https://neo4j.com/docs/cypher-manual/current/", resourceTitle: "Cypher Manual"}, {id: "cypher-extension-03", name: "Parameters", domain: "Cypher", level: 3, description: "Pass values as parameters to improve query reuse and avoid string-built query injection.", resourceUrl: "https://neo4j.com/docs/cypher-manual/current/", resourceTitle: "Cypher Manual"}, {id: "cypher-extension-04", name: "OPTIONAL MATCH", domain: "Cypher", level: 3, description: "Use OPTIONAL MATCH when related data may be absent and preserve the main result row.", resourceUrl: "https://neo4j.com/docs/cypher-manual/current/", resourceTitle: "Cypher Manual"}, {id: "cypher-extension-05", name: "List and map expressions", domain: "Cypher", level: 3, description: "Use list and map expressions to shape nested values for a result.", resourceUrl: "https://neo4j.com/docs/cypher-manual/current/", resourceTitle: "Cypher Manual"}, {id: "cypher-extension-06", name: "UNWIND", domain: "Cypher", level: 3, description: "Turn a list into rows with UNWIND when applying the same operation to many values.", resourceUrl: "https://neo4j.com/docs/cypher-manual/current/", resourceTitle: "Cypher Manual"}, {id: "cypher-extension-07", name: "MERGE with ON CREATE", domain: "Cypher", level: 3, description: "Use ON CREATE to initialize properties only when a pattern is first created.", resourceUrl: "https://neo4j.com/docs/cypher-manual/current/", resourceTitle: "Cypher Manual"}, {id: "cypher-extension-08", name: "MERGE with ON MATCH", domain: "Cypher", level: 3, description: "Use ON MATCH to handle a matched pattern without duplicating graph structure.", resourceUrl: "https://neo4j.com/docs/cypher-manual/current/", resourceTitle: "Cypher Manual"}, {id: "cypher-extension-09", name: "SET and property updates", domain: "Cypher", level: 3, description: "Update selected node or relationship properties with SET.", resourceUrl: "https://neo4j.com/docs/cypher-manual/current/", resourceTitle: "Cypher Manual"}, {id: "cypher-extension-10", name: "DELETE and DETACH DELETE", domain: "Cypher", level: 5, description: "Understand relationship requirements before deleting nodes or relationships.", resourceUrl: "https://neo4j.com/docs/cypher-manual/current/", resourceTitle: "Cypher Manual"}, {id: "cypher-extension-11", name: "Variable-length paths", domain: "Cypher", level: 5, description: "Bound variable-length traversals to explore connected paths without runaway expansion.", resourceUrl: "https://neo4j.com/docs/cypher-manual/current/", resourceTitle: "Cypher Manual"}, {id: "cypher-extension-12", name: "Shortest-path queries", domain: "Cypher", level: 5, description: "Use shortest-path functions when the question asks for the minimum-hop connection.", resourceUrl: "https://neo4j.com/docs/cypher-manual/current/", resourceTitle: "Cypher Manual"}, {id: "cypher-extension-13", name: "Aggregation grouping", domain: "Cypher", level: 5, description: "Recognize how non-aggregated return expressions determine grouping in a query.", resourceUrl: "https://neo4j.com/docs/cypher-manual/current/", resourceTitle: "Cypher Manual"}, {id: "cypher-extension-14", name: "COLLECT and DISTINCT", domain: "Cypher", level: 5, description: "Collect related values while using DISTINCT to avoid duplicate output entries.", resourceUrl: "https://neo4j.com/docs/cypher-manual/current/", resourceTitle: "Cypher Manual"}, {id: "cypher-extension-15", name: "Subqueries with CALL", domain: "Cypher", level: 5, description: "Use CALL subqueries to isolate a query section and return a compact result.", resourceUrl: "https://neo4j.com/docs/cypher-manual/current/", resourceTitle: "Cypher Manual"}, {id: "cypher-extension-16", name: "Conditional query logic", domain: "Cypher", level: 5, description: "Use conditional Cypher constructs to apply a branch only when its condition holds.", resourceUrl: "https://neo4j.com/docs/cypher-manual/current/", resourceTitle: "Cypher Manual"}, {id: "cypher-extension-17", name: "Querying dates and durations", domain: "Cypher", level: 5, description: "Filter and compare temporal values with explicit date and duration semantics.", resourceUrl: "https://neo4j.com/docs/cypher-manual/current/", resourceTitle: "Cypher Manual"}, {id: "cypher-extension-18", name: "Returning structured records", domain: "Cypher", level: 6, description: "Return named scalar fields and maps instead of whole graph elements when possible.", resourceUrl: "https://neo4j.com/docs/cypher-manual/current/", resourceTitle: "Cypher Manual"}, {id: "cypher-extension-19", name: "Pagination", domain: "Cypher", level: 6, description: "Use stable ordering with SKIP and LIMIT when a result must be paginated.", resourceUrl: "https://neo4j.com/docs/cypher-manual/current/", resourceTitle: "Cypher Manual"}, {id: "cypher-extension-20", name: "Query-plan tuning", domain: "Cypher", level: 6, description: "Reduce unnecessary matches and inspect the query plan before increasing database resources.", resourceUrl: "https://neo4j.com/docs/cypher-manual/current/", resourceTitle: "Cypher Manual"}, {id: "cypher-extension-21", name: "Query subqueries and scope", domain: "Cypher", level: 6, description: "Use subqueries with clear variable scope to structure complex queries.", resourceUrl: "https://neo4j.com/docs/cypher-manual/current/", resourceTitle: "Cypher Manual"}, {id: "cypher-extension-22", name: "Path predicates and filtering", domain: "Cypher", level: 6, description: "Filter paths with bounded patterns and predicates suited to the question.", resourceUrl: "https://neo4j.com/docs/cypher-manual/current/", resourceTitle: "Cypher Manual"}, {id: "cypher-extension-23", name: "Schema-aware query design", domain: "Cypher", level: 6, description: "Align query patterns with constraints and indexes in the data model.", resourceUrl: "https://neo4j.com/docs/cypher-manual/current/", resourceTitle: "Cypher Manual"}, {id: "cypher-extension-24", name: "Write-query safety", domain: "Cypher", level: 6, description: "Validate match scope and expected row counts before applying graph updates.", resourceUrl: "https://neo4j.com/docs/cypher-manual/current/", resourceTitle: "Cypher Manual"}, {id: "cypher-extension-25", name: "Complex query review", domain: "Cypher", level: 6, description: "Explain a multi-stage query and identify opportunities to simplify it.", resourceUrl: "https://neo4j.com/docs/cypher-manual/current/", resourceTitle: "Cypher Manual"}, {id: "graphrag-extension-01", name: "Document ingestion", domain: "GraphRAG", level: 3, description: "Track document origin and ingest content in a repeatable, auditable process.", resourceUrl: "https://neo4j.com/docs/neo4j-graphrag-python/current/", resourceTitle: "Neo4j GraphRAG resources"}, {id: "graphrag-extension-02", name: "Text chunking", domain: "GraphRAG", level: 3, description: "Split source text into coherent chunks that preserve enough context for retrieval.", resourceUrl: "https://neo4j.com/docs/neo4j-graphrag-python/current/", resourceTitle: "Neo4j GraphRAG resources"}, {id: "graphrag-extension-03", name: "Chunk metadata", domain: "GraphRAG", level: 3, description: "Attach source, section, and timestamp metadata so retrieved passages remain traceable.", resourceUrl: "https://neo4j.com/docs/neo4j-graphrag-python/current/", resourceTitle: "Neo4j GraphRAG resources"}, {id: "graphrag-extension-04", name: "Entity extraction", domain: "GraphRAG", level: 3, description: "Extract candidate entities from text and retain links back to their source passages.", resourceUrl: "https://neo4j.com/docs/neo4j-graphrag-python/current/", resourceTitle: "Neo4j GraphRAG resources"}, {id: "graphrag-extension-05", name: "Entity resolution", domain: "GraphRAG", level: 3, description: "Resolve duplicate entity mentions using evidence rather than name similarity alone.", resourceUrl: "https://neo4j.com/docs/neo4j-graphrag-python/current/", resourceTitle: "Neo4j GraphRAG resources"}, {id: "graphrag-extension-06", name: "Knowledge graph construction", domain: "GraphRAG", level: 3, description: "Create typed entities and relationships from validated source evidence.", resourceUrl: "https://neo4j.com/docs/neo4j-graphrag-python/current/", resourceTitle: "Neo4j GraphRAG resources"}, {id: "graphrag-extension-07", name: "Embedding generation", domain: "GraphRAG", level: 3, description: "Generate vector representations with a consistent model for indexed documents.", resourceUrl: "https://neo4j.com/docs/neo4j-graphrag-python/current/", resourceTitle: "Neo4j GraphRAG resources"}, {id: "graphrag-extension-08", name: "Vector index configuration", domain: "GraphRAG", level: 3, description: "Configure the vector index dimensions and similarity function to match embeddings.", resourceUrl: "https://neo4j.com/docs/neo4j-graphrag-python/current/", resourceTitle: "Neo4j GraphRAG resources"}, {id: "graphrag-extension-09", name: "Hybrid retrieval", domain: "GraphRAG", level: 3, description: "Combine lexical and semantic retrieval when either approach alone misses relevant evidence.", resourceUrl: "https://neo4j.com/docs/neo4j-graphrag-python/current/", resourceTitle: "Neo4j GraphRAG resources"}, {id: "graphrag-extension-10", name: "Graph neighborhood retrieval", domain: "GraphRAG", level: 5, description: "Expand retrieved entities to relevant graph neighbors with bounded traversal rules.", resourceUrl: "https://neo4j.com/docs/neo4j-graphrag-python/current/", resourceTitle: "Neo4j GraphRAG resources"}, {id: "graphrag-extension-11", name: "Context ranking", domain: "GraphRAG", level: 5, description: "Rank retrieved passages and graph facts by relevance to the current question.", resourceUrl: "https://neo4j.com/docs/neo4j-graphrag-python/current/", resourceTitle: "Neo4j GraphRAG resources"}, {id: "graphrag-extension-12", name: "Query decomposition", domain: "GraphRAG", level: 5, description: "Break a multi-part question into answerable retrieval subqueries.", resourceUrl: "https://neo4j.com/docs/neo4j-graphrag-python/current/", resourceTitle: "Neo4j GraphRAG resources"}, {id: "graphrag-extension-13", name: "Source attribution", domain: "GraphRAG", level: 5, description: "Keep citations attached to retrieved claims so readers can inspect their evidence.", resourceUrl: "https://neo4j.com/docs/neo4j-graphrag-python/current/", resourceTitle: "Neo4j GraphRAG resources"}, {id: "graphrag-extension-14", name: "Context window budgeting", domain: "GraphRAG", level: 5, description: "Select a compact evidence set that fits the model context limit.", resourceUrl: "https://neo4j.com/docs/neo4j-graphrag-python/current/", resourceTitle: "Neo4j GraphRAG resources"}, {id: "graphrag-extension-15", name: "Grounded answer generation", domain: "GraphRAG", level: 5, description: "Generate answers only from retrieved evidence and state when evidence is missing.", resourceUrl: "https://neo4j.com/docs/neo4j-graphrag-python/current/", resourceTitle: "Neo4j GraphRAG resources"}, {id: "graphrag-extension-16", name: "Retrieval evaluation", domain: "GraphRAG", level: 5, description: "Measure whether relevant source records appear in the retrieved result set.", resourceUrl: "https://neo4j.com/docs/neo4j-graphrag-python/current/", resourceTitle: "Neo4j GraphRAG resources"}, {id: "graphrag-extension-17", name: "Answer faithfulness evaluation", domain: "GraphRAG", level: 5, description: "Check whether each answer claim is supported by retrieved graph or text evidence.", resourceUrl: "https://neo4j.com/docs/neo4j-graphrag-python/current/", resourceTitle: "Neo4j GraphRAG resources"}, {id: "graphrag-extension-18", name: "Freshness and re-indexing", domain: "GraphRAG", level: 6, description: "Update changed sources and embeddings so retrieval does not serve stale information.", resourceUrl: "https://neo4j.com/docs/neo4j-graphrag-python/current/", resourceTitle: "Neo4j GraphRAG resources"}, {id: "graphrag-extension-19", name: "Privacy-aware retrieval", domain: "GraphRAG", level: 6, description: "Exclude restricted records before retrieval and avoid leaking sensitive source content.", resourceUrl: "https://neo4j.com/docs/neo4j-graphrag-python/current/", resourceTitle: "Neo4j GraphRAG resources"}, {id: "graphrag-extension-20", name: "End-to-end GraphRAG evaluation", domain: "GraphRAG", level: 6, description: "Evaluate retrieval, grounding, usefulness, and latency across repeatable questions.", resourceUrl: "https://neo4j.com/docs/neo4j-graphrag-python/current/", resourceTitle: "Neo4j GraphRAG resources"}, {id: "graphrag-extension-21", name: "Retrieval policy and access control", domain: "GraphRAG", level: 6, description: "Apply authorization filters before returning graph or document evidence.", resourceUrl: "https://neo4j.com/docs/neo4j-graphrag-python/current/", resourceTitle: "Neo4j GraphRAG resources"}, {id: "graphrag-extension-22", name: "Knowledge graph provenance", domain: "GraphRAG", level: 6, description: "Keep source and extraction provenance attached to graph facts.", resourceUrl: "https://neo4j.com/docs/neo4j-graphrag-python/current/", resourceTitle: "Neo4j GraphRAG resources"}, {id: "graphrag-extension-23", name: "Retrieval error analysis", domain: "GraphRAG", level: 6, description: "Inspect missed evidence and irrelevant results to find retrieval failure modes.", resourceUrl: "https://neo4j.com/docs/neo4j-graphrag-python/current/", resourceTitle: "Neo4j GraphRAG resources"}, {id: "graphrag-extension-24", name: "Human review for uncertain answers", domain: "GraphRAG", level: 6, description: "Escalate answers when retrieved sources conflict or do not support a claim.", resourceUrl: "https://neo4j.com/docs/neo4j-graphrag-python/current/", resourceTitle: "Neo4j GraphRAG resources"}, {id: "graphrag-extension-25", name: "GraphRAG capstone", domain: "GraphRAG", level: 6, description: "Build and evaluate a traceable graph-grounded retrieval workflow end to end.", resourceUrl: "https://neo4j.com/docs/neo4j-graphrag-python/current/", resourceTitle: "Neo4j GraphRAG resources"}, {id: "agent-extension-01", name: "Agent roles and boundaries", domain: "AI agents", level: 3, description: "Define the agent's responsibility and the tasks it must hand back or decline.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "agent-extension-02", name: "Instruction hierarchy", domain: "AI agents", level: 3, description: "Resolve conflicting instructions by following the application's trusted instruction order.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "agent-extension-03", name: "Tool schemas", domain: "AI agents", level: 3, description: "Describe tool inputs and outputs precisely so requested operations can be validated.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "agent-extension-04", name: "Tool result validation", domain: "AI agents", level: 3, description: "Validate tool output types and business rules before using returned values.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "agent-extension-05", name: "Planning and task decomposition", domain: "AI agents", level: 3, description: "Split a task into bounded steps and use evidence to decide what to do next.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "agent-extension-06", name: "Conversation state", domain: "AI agents", level: 3, description: "Track only the state needed to complete the task and keep it separate from assumptions.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "agent-extension-07", name: "Agent memory", domain: "AI agents", level: 3, description: "Store useful memory with provenance, scope, and retention rules.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "agent-extension-08", name: "Workflow orchestration", domain: "AI agents", level: 3, description: "Coordinate model calls and tools with explicit control flow and error handling.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "agent-extension-09", name: "Stopping conditions", domain: "AI agents", level: 3, description: "Set a clear completion rule and a maximum number of steps for an agent run.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "agent-extension-10", name: "Retries and backoff", domain: "AI agents", level: 5, description: "Retry transient failures with limits and increasing delays while avoiding duplicate actions.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "agent-extension-11", name: "Idempotent tools", domain: "AI agents", level: 5, description: "Design repeatable tool operations so a retry does not create duplicate side effects.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "agent-extension-12", name: "Human review checkpoints", domain: "AI agents", level: 5, description: "Route high-impact or uncertain actions to an appropriate human review step.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "agent-extension-13", name: "Multi-agent delegation", domain: "AI agents", level: 5, description: "Delegate a bounded subtask with context and validate the returned result.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "agent-extension-14", name: "Structured output", domain: "AI agents", level: 5, description: "Constrain model responses to a validated schema when downstream code depends on them.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "agent-extension-15", name: "Agent failure recovery", domain: "AI agents", level: 5, description: "Return a useful fallback when a tool or model fails instead of inventing success.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "agent-extension-16", name: "Evaluation datasets", domain: "AI agents", level: 5, description: "Build repeatable evaluation cases with expected outcomes and relevant tool usage.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "agent-extension-17", name: "Agent quality metrics", domain: "AI agents", level: 5, description: "Measure task success, groundedness, tool correctness, and latency together.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "agent-extension-18", name: "Safety red teaming", domain: "AI agents", level: 6, description: "Probe for prompt injection, unsafe tool calls, and unsupported claims before release.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "agent-extension-19", name: "Agent observability", domain: "AI agents", level: 6, description: "Log useful operational events without exposing secrets or unnecessary personal data.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "agent-extension-20", name: "Agent release management", domain: "AI agents", level: 6, description: "Version prompts and tools, evaluate changes, and provide a rollback path.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "agent-extension-21", name: "Permission-aware tool execution", domain: "AI agents", level: 6, description: "Check user and application permissions immediately before a tool performs an action.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "agent-extension-22", name: "Model and tool cost controls", domain: "AI agents", level: 6, description: "Set limits for model calls, tool calls, and runtime within a task.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "agent-extension-23", name: "Trace-based debugging", domain: "AI agents", level: 6, description: "Follow a run trace across model decisions, tool inputs, outputs, and errors.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "agent-extension-24", name: "Adversarial workflow testing", domain: "AI agents", level: 6, description: "Test instruction conflicts and malicious tool output using bounded scenarios.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "agent-extension-25", name: "Reliable agent capstone", domain: "AI agents", level: 6, description: "Evaluate a bounded agent workflow for success, safety, recovery, and cost.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "german-extension-01", name: "German alphabet and spelling", domain: "German language", level: 1, description: "Recognize German letter names, umlauts, and the Eszett in common words.", resourceUrl: "https://www.goethe.de/ins/de/en/kur/ueb.html", resourceTitle: "Goethe-Institut free German practice"}, {id: "german-extension-02", name: "German pronunciation", domain: "German language", level: 1, description: "Practice vowel length, common consonant sounds, and word stress with audio.", resourceUrl: "https://www.goethe.de/ins/de/en/kur/ueb.html", resourceTitle: "Goethe-Institut free German practice"}, {id: "german-extension-03", name: "Introducing yourself", domain: "German language", level: 1, description: "Share your name, origin, languages, and a simple personal detail.", resourceUrl: "https://www.goethe.de/ins/de/en/kur/ueb.html", resourceTitle: "Goethe-Institut free German practice"}, {id: "german-extension-04", name: "Numbers and counting", domain: "German language", level: 1, description: "Understand and say common cardinal numbers in everyday contexts.", resourceUrl: "https://www.goethe.de/ins/de/en/kur/ueb.html", resourceTitle: "Goethe-Institut free German practice"}, {id: "german-extension-05", name: "Days, months, and dates", domain: "German language", level: 1, description: "Ask for and state the day, month, and date in a familiar format.", resourceUrl: "https://www.goethe.de/ins/de/en/kur/ueb.html", resourceTitle: "Goethe-Institut free German practice"}, {id: "german-extension-06", name: "Noun gender and articles", domain: "German language", level: 1, description: "Learn nouns together with der, die, or das rather than as isolated words.", resourceUrl: "https://www.goethe.de/ins/de/en/kur/ueb.html", resourceTitle: "Goethe-Institut free German practice"}, {id: "german-extension-07", name: "Plural forms", domain: "German language", level: 1, description: "Recognize common plural patterns while checking each noun's learned plural form.", resourceUrl: "https://www.goethe.de/ins/de/en/kur/ueb.html", resourceTitle: "Goethe-Institut free German practice"}, {id: "german-extension-08", name: "Personal pronouns", domain: "German language", level: 1, description: "Choose personal pronouns that match the person or people being discussed.", resourceUrl: "https://www.goethe.de/ins/de/en/kur/ueb.html", resourceTitle: "Goethe-Institut free German practice"}, {id: "german-extension-09", name: "The verbs sein and haben", domain: "German language", level: 1, description: "Use sein and haben in simple present-tense statements and questions.", resourceUrl: "https://www.goethe.de/ins/de/en/kur/ueb.html", resourceTitle: "Goethe-Institut free German practice"}, {id: "german-extension-10", name: "Present-tense verb endings", domain: "German language", level: 3, description: "Conjugate regular present-tense verbs to match the sentence subject.", resourceUrl: "https://www.goethe.de/ins/de/en/kur/ueb.html", resourceTitle: "Goethe-Institut free German practice"}, {id: "german-extension-11", name: "German sentence word order", domain: "German language", level: 3, description: "Place the finite verb correctly in a simple main clause.", resourceUrl: "https://www.goethe.de/ins/de/en/kur/ueb.html", resourceTitle: "Goethe-Institut free German practice"}, {id: "german-extension-12", name: "Yes-no and W-questions", domain: "German language", level: 3, description: "Form basic questions with an inverted verb or a question word.", resourceUrl: "https://www.goethe.de/ins/de/en/kur/ueb.html", resourceTitle: "Goethe-Institut free German practice"}, {id: "german-extension-13", name: "Negation with nicht and kein", domain: "German language", level: 3, description: "Choose nicht or kein to negate a statement in a basic context.", resourceUrl: "https://www.goethe.de/ins/de/en/kur/ueb.html", resourceTitle: "Goethe-Institut free German practice"}, {id: "german-extension-14", name: "Accusative case", domain: "German language", level: 3, description: "Recognize common direct objects and the accusative article changes.", resourceUrl: "https://www.goethe.de/ins/de/en/kur/ueb.html", resourceTitle: "Goethe-Institut free German practice"}, {id: "german-extension-15", name: "Dative case", domain: "German language", level: 3, description: "Recognize common indirect objects and frequent dative prepositions.", resourceUrl: "https://www.goethe.de/ins/de/en/kur/ueb.html", resourceTitle: "Goethe-Institut free German practice"}, {id: "german-extension-16", name: "Modal verbs", domain: "German language", level: 3, description: "Use a modal verb with an infinitive to express ability, obligation, or preference.", resourceUrl: "https://www.goethe.de/ins/de/en/kur/ueb.html", resourceTitle: "Goethe-Institut free German practice"}, {id: "german-extension-17", name: "Separable verbs", domain: "German language", level: 3, description: "Place the prefix of a separable verb at the end of a main clause.", resourceUrl: "https://www.goethe.de/ins/de/en/kur/ueb.html", resourceTitle: "Goethe-Institut free German practice"}, {id: "german-extension-18", name: "Everyday directions", domain: "German language", level: 5, description: "Ask for and understand simple directions to a nearby destination.", resourceUrl: "https://www.goethe.de/ins/de/en/kur/ueb.html", resourceTitle: "Goethe-Institut free German practice"}, {id: "german-extension-19", name: "Ordering food and drinks", domain: "German language", level: 5, description: "Order politely and understand a short cafe or restaurant exchange.", resourceUrl: "https://www.goethe.de/ins/de/en/kur/ueb.html", resourceTitle: "Goethe-Institut free German practice"}, {id: "german-extension-20", name: "Listening for key information", domain: "German language", level: 5, description: "Listen for names, times, places, and other key details in short speech.", resourceUrl: "https://www.goethe.de/ins/de/en/kur/ueb.html", resourceTitle: "Goethe-Institut free German practice"}, {id: "german-extension-21", name: "Past-tense storytelling", domain: "German language", level: 5, description: "Describe familiar past events with common German past-tense forms.", resourceUrl: "https://www.goethe.de/ins/de/en/kur/ueb.html", resourceTitle: "Goethe-Institut free German practice"}, {id: "german-extension-22", name: "Subordinate clauses", domain: "German language", level: 5, description: "Recognize verb placement in common clauses introduced by weil and dass.", resourceUrl: "https://www.goethe.de/ins/de/en/kur/ueb.html", resourceTitle: "Goethe-Institut free German practice"}, {id: "german-extension-23", name: "Everyday appointment planning", domain: "German language", level: 5, description: "Arrange a simple appointment and confirm time and location.", resourceUrl: "https://www.goethe.de/ins/de/en/kur/ueb.html", resourceTitle: "Goethe-Institut free German practice"}, {id: "german-extension-24", name: "Reading short practical texts", domain: "German language", level: 5, description: "Find key information in a short notice, message, or simple form.", resourceUrl: "https://www.goethe.de/ins/de/en/kur/ueb.html", resourceTitle: "Goethe-Institut free German practice"}, {id: "german-extension-25", name: "Independent learning plan", domain: "German language", level: 5, description: "Choose a suitable next German practice activity from observed gaps.", resourceUrl: "https://www.goethe.de/ins/de/en/kur/ueb.html", resourceTitle: "Goethe-Institut free German practice"}, {id: "dance-extension-01", name: "Thai dance history", domain: "Thai dance", level: 1, description: "Connect a dance form to its historical setting and cultural purpose.", resourceUrl: "https://thailandfoundation.or.th/rakram-ep-5-central-thai-dance/", resourceTitle: "Thailand Foundation: Rakram Thai Dance Course"}, {id: "dance-extension-02", name: "Respectful classroom practice", domain: "Thai dance", level: 1, description: "Follow a teacher's guidance and observe respectful studio etiquette.", resourceUrl: "https://thailandfoundation.or.th/rakram-ep-5-central-thai-dance/", resourceTitle: "Thailand Foundation: Rakram Thai Dance Course"}, {id: "dance-extension-03", name: "Basic standing posture", domain: "Thai dance", level: 1, description: "Practice a comfortable, aligned posture under qualified instruction.", resourceUrl: "https://thailandfoundation.or.th/rakram-ep-5-central-thai-dance/", resourceTitle: "Thailand Foundation: Rakram Thai Dance Course"}, {id: "dance-extension-04", name: "Hand gesture vocabulary", domain: "Thai dance", level: 1, description: "Learn a small set of traditional hand gestures from a qualified teacher.", resourceUrl: "https://thailandfoundation.or.th/rakram-ep-5-central-thai-dance/", resourceTitle: "Thailand Foundation: Rakram Thai Dance Course"}, {id: "dance-extension-05", name: "Finger and wrist articulation", domain: "Thai dance", level: 1, description: "Develop controlled hand movement without forcing joints or range.", resourceUrl: "https://thailandfoundation.or.th/rakram-ep-5-central-thai-dance/", resourceTitle: "Thailand Foundation: Rakram Thai Dance Course"}, {id: "dance-extension-06", name: "Arm curves and pathways", domain: "Thai dance", level: 1, description: "Trace arm pathways with relaxed shoulders and teacher feedback.", resourceUrl: "https://thailandfoundation.or.th/rakram-ep-5-central-thai-dance/", resourceTitle: "Thailand Foundation: Rakram Thai Dance Course"}, {id: "dance-extension-07", name: "Foot placement basics", domain: "Thai dance", level: 1, description: "Practice beginner foot placement slowly on a clear, safe surface.", resourceUrl: "https://thailandfoundation.or.th/rakram-ep-5-central-thai-dance/", resourceTitle: "Thailand Foundation: Rakram Thai Dance Course"}, {id: "dance-extension-08", name: "Weight transfer", domain: "Thai dance", level: 1, description: "Shift weight deliberately to maintain balance through a movement phrase.", resourceUrl: "https://thailandfoundation.or.th/rakram-ep-5-central-thai-dance/", resourceTitle: "Thailand Foundation: Rakram Thai Dance Course"}, {id: "dance-extension-09", name: "Rhythm and musical counts", domain: "Thai dance", level: 1, description: "Count a short phrase and coordinate movement with its musical pulse.", resourceUrl: "https://thailandfoundation.or.th/rakram-ep-5-central-thai-dance/", resourceTitle: "Thailand Foundation: Rakram Thai Dance Course"}, {id: "dance-extension-10", name: "Movement transitions", domain: "Thai dance", level: 1, description: "Connect two learned movements smoothly without rushing the transition.", resourceUrl: "https://thailandfoundation.or.th/rakram-ep-5-central-thai-dance/", resourceTitle: "Thailand Foundation: Rakram Thai Dance Course"}, {id: "dance-extension-11", name: "Gesture and storytelling", domain: "Thai dance", level: 1, description: "Relate movement qualities to the story or meaning explained by a teacher.", resourceUrl: "https://thailandfoundation.or.th/rakram-ep-5-central-thai-dance/", resourceTitle: "Thailand Foundation: Rakram Thai Dance Course"}, {id: "dance-extension-12", name: "Traditional costume context", domain: "Thai dance", level: 1, description: "Identify how costume elements relate to a performance tradition.", resourceUrl: "https://thailandfoundation.or.th/rakram-ep-5-central-thai-dance/", resourceTitle: "Thailand Foundation: Rakram Thai Dance Course"}, {id: "dance-extension-13", name: "Regional dance forms", domain: "Thai dance", level: 3, description: "Notice that Thai dance includes regional forms with distinct histories and styles.", resourceUrl: "https://thailandfoundation.or.th/rakram-ep-5-central-thai-dance/", resourceTitle: "Thailand Foundation: Rakram Thai Dance Course"}, {id: "dance-extension-14", name: "Warm-up and mobility", domain: "Thai dance", level: 3, description: "Prepare gently for practice and avoid forcing unfamiliar positions.", resourceUrl: "https://thailandfoundation.or.th/rakram-ep-5-central-thai-dance/", resourceTitle: "Thailand Foundation: Rakram Thai Dance Course"}, {id: "dance-extension-15", name: "Balance and control", domain: "Thai dance", level: 3, description: "Build balance through slow, supported practice and controlled movement.", resourceUrl: "https://thailandfoundation.or.th/rakram-ep-5-central-thai-dance/", resourceTitle: "Thailand Foundation: Rakram Thai Dance Course"}, {id: "dance-extension-16", name: "Learning from demonstration", domain: "Thai dance", level: 3, description: "Observe a teacher's demonstration before attempting a new sequence.", resourceUrl: "https://thailandfoundation.or.th/rakram-ep-5-central-thai-dance/", resourceTitle: "Thailand Foundation: Rakram Thai Dance Course"}, {id: "dance-extension-17", name: "Short movement sequence", domain: "Thai dance", level: 3, description: "Combine a few familiar gestures into a short teacher-guided phrase.", resourceUrl: "https://thailandfoundation.or.th/rakram-ep-5-central-thai-dance/", resourceTitle: "Thailand Foundation: Rakram Thai Dance Course"}, {id: "dance-extension-18", name: "Music and ensemble awareness", domain: "Thai dance", level: 3, description: "Maintain timing while staying aware of other performers in a group.", resourceUrl: "https://thailandfoundation.or.th/rakram-ep-5-central-thai-dance/", resourceTitle: "Thailand Foundation: Rakram Thai Dance Course"}, {id: "dance-extension-19", name: "Performance preparation", domain: "Thai dance", level: 3, description: "Prepare a short piece with attention to timing, costume, and cultural context.", resourceUrl: "https://thailandfoundation.or.th/rakram-ep-5-central-thai-dance/", resourceTitle: "Thailand Foundation: Rakram Thai Dance Course"}, {id: "dance-extension-20", name: "Reflective practice", domain: "Thai dance", level: 3, description: "Use teacher feedback and personal reflection to plan a safe next practice step.", resourceUrl: "https://thailandfoundation.or.th/rakram-ep-5-central-thai-dance/", resourceTitle: "Thailand Foundation: Rakram Thai Dance Course"}, {id: "dance-extension-21", name: "Classical, folk, and creative forms", domain: "Thai dance", level: 3, description: "Compare broad Thai performing-arts categories without treating them as interchangeable.", resourceUrl: "https://thailandfoundation.or.th/rakram-ep-5-central-thai-dance/", resourceTitle: "Thailand Foundation: Rakram Thai Dance Course"}, {id: "dance-extension-22", name: "Dance drama and narrative", domain: "Thai dance", level: 3, description: "Explore how movement, music, costume, and story work together in a taught form.", resourceUrl: "https://thailandfoundation.or.th/rakram-ep-5-central-thai-dance/", resourceTitle: "Thailand Foundation: Rakram Thai Dance Course"}, {id: "dance-extension-23", name: "Regional style comparison", domain: "Thai dance", level: 3, description: "Compare regional performance traditions using reliable cultural sources and teacher guidance.", resourceUrl: "https://thailandfoundation.or.th/rakram-ep-5-central-thai-dance/", resourceTitle: "Thailand Foundation: Rakram Thai Dance Course"}, {id: "dance-extension-24", name: "Repertoire and movement quality", domain: "Thai dance", level: 3, description: "Refine a teacher-selected phrase through timing, clarity, and expressive intention.", resourceUrl: "https://thailandfoundation.or.th/rakram-ep-5-central-thai-dance/", resourceTitle: "Thailand Foundation: Rakram Thai Dance Course"}, {id: "dance-extension-25", name: "Performance reflection and care", domain: "Thai dance", level: 5, description: "Reflect on performance feedback and plan sustainable, respectful continued study.", resourceUrl: "https://thailandfoundation.or.th/rakram-ep-5-central-thai-dance/", resourceTitle: "Thailand Foundation: Rakram Thai Dance Course"}, {id: "dance-extension-26", name: "Khon and masked dance-drama context", domain: "Thai dance", level: 5, description: "Study Khon as a distinct masked dance-drama tradition through authoritative cultural resources.", resourceUrl: "https://thailandfoundation.or.th/rakram-ep-5-central-thai-dance/", resourceTitle: "Thailand Foundation: Rakram Thai Dance Course"}, {id: "dance-extension-27", name: "Lakhon and court dance context", domain: "Thai dance", level: 5, description: "Explore court dance-drama traditions with attention to their different performance conventions.", resourceUrl: "https://thailandfoundation.or.th/rakram-ep-5-central-thai-dance/", resourceTitle: "Thailand Foundation: Rakram Thai Dance Course"}, {id: "dance-extension-28", name: "Piphat ensemble and movement", domain: "Thai dance", level: 5, description: "Recognize how a traditional ensemble supports the timing and character of a performance.", resourceUrl: "https://thailandfoundation.or.th/rakram-ep-5-central-thai-dance/", resourceTitle: "Thailand Foundation: Rakram Thai Dance Course"}, {id: "dance-extension-29", name: "Costume, mask, and character", domain: "Thai dance", level: 5, description: "Describe how a teacher explains costume or mask choices in a specific performance tradition.", resourceUrl: "https://thailandfoundation.or.th/rakram-ep-5-central-thai-dance/", resourceTitle: "Thailand Foundation: Rakram Thai Dance Course"}, {id: "dance-extension-30", name: "Wai Kru and respectful learning", domain: "Thai dance", level: 5, description: "Learn the purpose and context of a teacher-led opening ritual where appropriate.", resourceUrl: "https://thailandfoundation.or.th/rakram-ep-5-central-thai-dance/", resourceTitle: "Thailand Foundation: Rakram Thai Dance Course"}, {id: "dance-extension-31", name: "Phrase notation and recall", domain: "Thai dance", level: 5, description: "Record a short movement phrase using simple counts and teacher-approved notes.", resourceUrl: "https://thailandfoundation.or.th/rakram-ep-5-central-thai-dance/", resourceTitle: "Thailand Foundation: Rakram Thai Dance Course"}, {id: "dance-extension-32", name: "Ensemble spacing and stage awareness", domain: "Thai dance", level: 5, description: "Maintain safe spacing and awareness during a guided group phrase.", resourceUrl: "https://thailandfoundation.or.th/rakram-ep-5-central-thai-dance/", resourceTitle: "Thailand Foundation: Rakram Thai Dance Course"}, {id: "dance-extension-33", name: "Expressive transitions", domain: "Thai dance", level: 5, description: "Refine transitions in a learned phrase without forcing range or imitating out of context.", resourceUrl: "https://thailandfoundation.or.th/rakram-ep-5-central-thai-dance/", resourceTitle: "Thailand Foundation: Rakram Thai Dance Course"}, {id: "dance-extension-34", name: "Rehearsal and peer feedback", domain: "Thai dance", level: 5, description: "Use specific, respectful observations to support a supervised rehearsal.", resourceUrl: "https://thailandfoundation.or.th/rakram-ep-5-central-thai-dance/", resourceTitle: "Thailand Foundation: Rakram Thai Dance Course"}, {id: "dance-extension-35", name: "Curated performance study", domain: "Thai dance", level: 5, description: "Analyze a performance with attention to form, context, music, and source attribution.", resourceUrl: "https://thailandfoundation.or.th/rakram-ep-5-central-thai-dance/", resourceTitle: "Thailand Foundation: Rakram Thai Dance Course"}, {id: "muaythai-extension-01", name: "Muay Thai history and rules", domain: "Thai boxing", level: 1, description: "Describe the sport's context and follow the rules taught by a qualified coach.", resourceUrl: "https://muaythai.sport/about-muaythai/muaythai-rules/", resourceTitle: "IFMA: Muaythai Rules and Disciplines"}, {id: "muaythai-extension-02", name: "Training space and equipment safety", domain: "Thai boxing", level: 1, description: "Check training space and equipment with a coach before practice.", resourceUrl: "https://muaythai.sport/about-muaythai/muaythai-rules/", resourceTitle: "IFMA: Muaythai Rules and Disciplines"}, {id: "muaythai-extension-03", name: "Warm-up and movement readiness", domain: "Thai boxing", level: 1, description: "Use a coach-approved warm-up and stop when pain or dizziness occurs.", resourceUrl: "https://muaythai.sport/about-muaythai/muaythai-rules/", resourceTitle: "IFMA: Muaythai Rules and Disciplines"}, {id: "muaythai-extension-04", name: "Balanced stance practice", domain: "Thai boxing", level: 1, description: "Maintain a stable stance while moving at a pace appropriate to your experience.", resourceUrl: "https://muaythai.sport/about-muaythai/muaythai-rules/", resourceTitle: "IFMA: Muaythai Rules and Disciplines"}, {id: "muaythai-extension-05", name: "Guard and safe distance", domain: "Thai boxing", level: 1, description: "Keep a coach-taught guard and learn distance without unsupervised contact.", resourceUrl: "https://muaythai.sport/about-muaythai/muaythai-rules/", resourceTitle: "IFMA: Muaythai Rules and Disciplines"}, {id: "muaythai-extension-06", name: "Basic footwork", domain: "Thai boxing", level: 1, description: "Practice stepping and returning to stance under qualified supervision.", resourceUrl: "https://muaythai.sport/about-muaythai/muaythai-rules/", resourceTitle: "IFMA: Muaythai Rules and Disciplines"}, {id: "muaythai-extension-07", name: "Straight-punch mechanics", domain: "Thai boxing", level: 1, description: "Learn straight-punch mechanics slowly on pads with a qualified coach.", resourceUrl: "https://muaythai.sport/about-muaythai/muaythai-rules/", resourceTitle: "IFMA: Muaythai Rules and Disciplines"}, {id: "muaythai-extension-08", name: "Defensive movement", domain: "Thai boxing", level: 1, description: "Practice coach-taught defensive movement in controlled, non-contact drills.", resourceUrl: "https://muaythai.sport/about-muaythai/muaythai-rules/", resourceTitle: "IFMA: Muaythai Rules and Disciplines"}, {id: "muaythai-extension-09", name: "Teep fundamentals", domain: "Thai boxing", level: 1, description: "Learn the teep on pads with coaching and controlled range.", resourceUrl: "https://muaythai.sport/about-muaythai/muaythai-rules/", resourceTitle: "IFMA: Muaythai Rules and Disciplines"}, {id: "muaythai-extension-10", name: "Round-kick fundamentals", domain: "Thai boxing", level: 1, description: "Develop round-kick balance and pad technique under qualified supervision.", resourceUrl: "https://muaythai.sport/about-muaythai/muaythai-rules/", resourceTitle: "IFMA: Muaythai Rules and Disciplines"}, {id: "muaythai-extension-11", name: "Knee technique basics", domain: "Thai boxing", level: 1, description: "Learn basic knee mechanics on pads only with appropriate coaching and control.", resourceUrl: "https://muaythai.sport/about-muaythai/muaythai-rules/", resourceTitle: "IFMA: Muaythai Rules and Disciplines"}, {id: "muaythai-extension-12", name: "Elbow safety and rules", domain: "Thai boxing", level: 3, description: "Understand elbow rules and safety; practice only in a supervised setting.", resourceUrl: "https://muaythai.sport/about-muaythai/muaythai-rules/", resourceTitle: "IFMA: Muaythai Rules and Disciplines"}, {id: "muaythai-extension-13", name: "Pad-work communication", domain: "Thai boxing", level: 3, description: "Use clear coach-partner signals and follow agreed pad-work intensity.", resourceUrl: "https://muaythai.sport/about-muaythai/muaythai-rules/", resourceTitle: "IFMA: Muaythai Rules and Disciplines"}, {id: "muaythai-extension-14", name: "Combinations and balance", domain: "Thai boxing", level: 3, description: "Combine familiar techniques at controlled speed while returning to a balanced stance.", resourceUrl: "https://muaythai.sport/about-muaythai/muaythai-rules/", resourceTitle: "IFMA: Muaythai Rules and Disciplines"}, {id: "muaythai-extension-15", name: "Conditioning and recovery", domain: "Thai boxing", level: 3, description: "Balance conditioning with rest, hydration, and recovery guided by a coach.", resourceUrl: "https://muaythai.sport/about-muaythai/muaythai-rules/", resourceTitle: "IFMA: Muaythai Rules and Disciplines"}, {id: "muaythai-extension-16", name: "Technical shadowboxing", domain: "Thai boxing", level: 3, description: "Rehearse learned movements without contact and stop if form becomes unsafe.", resourceUrl: "https://muaythai.sport/about-muaythai/muaythai-rules/", resourceTitle: "IFMA: Muaythai Rules and Disciplines"}, {id: "muaythai-extension-17", name: "Training reflection and progression", domain: "Thai boxing", level: 3, description: "Track practice feedback and progress gradually with qualified instruction.", resourceUrl: "https://muaythai.sport/about-muaythai/muaythai-rules/", resourceTitle: "IFMA: Muaythai Rules and Disciplines"}, {id: "muaythai-extension-18", name: "Wai Kru and cultural context", domain: "Thai boxing", level: 3, description: "Learn the purpose of Wai Kru from qualified teachers and distinguish it from sport technique.", resourceUrl: "https://muaythai.sport/about-muaythai/muaythai-rules/", resourceTitle: "IFMA: Muaythai Rules and Disciplines"}, {id: "muaythai-extension-19", name: "Competition format and scoring", domain: "Thai boxing", level: 3, description: "Understand how the current rules define rounds, scoring, and permitted conduct.", resourceUrl: "https://muaythai.sport/about-muaythai/muaythai-rules/", resourceTitle: "IFMA: Muaythai Rules and Disciplines"}, {id: "muaythai-extension-20", name: "Protective equipment and checks", domain: "Thai boxing", level: 3, description: "Identify protective equipment and follow coach-led equipment checks.", resourceUrl: "https://muaythai.sport/about-muaythai/muaythai-rules/", resourceTitle: "IFMA: Muaythai Rules and Disciplines"}, {id: "muaythai-extension-21", name: "Pad-work progressions", domain: "Thai boxing", level: 3, description: "Progress pad drills gradually with a coach, agreed intensity, and clear stop signals.", resourceUrl: "https://muaythai.sport/about-muaythai/muaythai-rules/", resourceTitle: "IFMA: Muaythai Rules and Disciplines"}, {id: "muaythai-extension-22", name: "Technical reflection and athlete care", domain: "Thai boxing", level: 3, description: "Use coach feedback, rest, and appropriate medical guidance to plan training.", resourceUrl: "https://muaythai.sport/about-muaythai/muaythai-rules/", resourceTitle: "IFMA: Muaythai Rules and Disciplines"}, {id: "muaythai-extension-23", name: "Controlled combination sequencing", domain: "Thai boxing", level: 5, description: "Connect familiar pad techniques at coach-approved speed while preserving balance and control.", resourceUrl: "https://muaythai.sport/about-muaythai/muaythai-rules/", resourceTitle: "IFMA: Muaythai Rules and Disciplines"}, {id: "muaythai-extension-24", name: "Defensive awareness drills", domain: "Thai boxing", level: 5, description: "Develop distance and defensive awareness in supervised, non-contact partner drills.", resourceUrl: "https://muaythai.sport/about-muaythai/muaythai-rules/", resourceTitle: "IFMA: Muaythai Rules and Disciplines"}, {id: "muaythai-extension-25", name: "Technical and semi-contact pathway", domain: "Thai boxing", level: 5, description: "Compare controlled technical competition with other disciplines using current IFMA rules.", resourceUrl: "https://muaythai.sport/about-muaythai/muaythai-rules/", resourceTitle: "IFMA: Muaythai Rules and Disciplines"}, {id: "muaythai-extension-26", name: "Referee signals and sportsmanship", domain: "Thai boxing", level: 5, description: "Recognize basic officiating signals and respectful conduct in a rules-based sport.", resourceUrl: "https://muaythai.sport/about-muaythai/muaythai-rules/", resourceTitle: "IFMA: Muaythai Rules and Disciplines"}, {id: "muaythai-extension-27", name: "Competition rules and prohibited actions", domain: "Thai boxing", level: 5, description: "Use current IFMA rules to identify permitted techniques and actions that are prohibited.", resourceUrl: "https://muaythai.sport/about-muaythai/muaythai-rules/", resourceTitle: "IFMA: Muaythai Rules and Disciplines"}, {id: "muaythai-extension-28", name: "Training load and recovery planning", domain: "Thai boxing", level: 5, description: "Discuss gradual training load and recovery with a qualified coach.", resourceUrl: "https://muaythai.sport/about-muaythai/muaythai-rules/", resourceTitle: "IFMA: Muaythai Rules and Disciplines"}, {id: "muaythai-extension-29", name: "Youth safeguarding and consent", domain: "Thai boxing", level: 5, description: "Understand that age-appropriate safeguarding, consent, and supervision are essential.", resourceUrl: "https://muaythai.sport/about-muaythai/muaythai-rules/", resourceTitle: "IFMA: Muaythai Rules and Disciplines"}, {id: "muaythai-extension-30", name: "Technical skills assessment", domain: "Thai boxing", level: 5, description: "Use a coach-led rubric to review control, balance, and rule awareness without unsupervised sparring.", resourceUrl: "https://muaythai.sport/about-muaythai/muaythai-rules/", resourceTitle: "IFMA: Muaythai Rules and Disciplines"}, {id: "muaythai-extension-31", name: "Event preparation and weigh-in context", domain: "Thai boxing", level: 5, description: "Understand competition preparation requirements from current official rules and coaches.", resourceUrl: "https://muaythai.sport/about-muaythai/muaythai-rules/", resourceTitle: "IFMA: Muaythai Rules and Disciplines"}, {id: "muaythai-extension-32", name: "Ethics and athlete welfare", domain: "Thai boxing", level: 5, description: "Connect sportsmanship, fairness, safety, and athlete welfare to Muay Thai practice.", resourceUrl: "https://muaythai.sport/about-muaythai/muaythai-rules/", resourceTitle: "IFMA: Muaythai Rules and Disciplines"}] AS row
  MERGE (c:Concept {id: row.id, app: 'learnpath-ai'})
  SET c.name=row.name, c.domain=row.domain, c.level=row.level, c.description=row.description
  MERGE (r:Resource {url: row.resourceUrl, app: 'learnpath-ai'})
  SET r.title=row.resourceTitle
  MERGE (c)-[:EXPLAINED_IN]->(r)
  RETURN count(*) AS conceptsProcessed
}
CALL () {
  OPTIONAL MATCH (pre:Concept {app: 'learnpath-ai'})-[edge:PREREQUISITE_OF]->(:Concept {app: 'learnpath-ai'})
  WITH edge
  DELETE edge
  RETURN count(edge) AS oldPrerequisiteLinksRemoved
}
CALL () {
  OPTIONAL MATCH (:LearningGoal {app: 'learnpath-ai'})-[edge:REQUIRES]->(:Concept {app: 'learnpath-ai'})
  WITH edge
  DELETE edge
  RETURN count(edge) AS oldGoalLinksRemoved
}
