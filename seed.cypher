}
CALL () {
  UNWIND [{id: "python-data-analyst", name: "Become a Python data analyst", requires: ["data-visualization", "ml-basics", "python-extension-18", "python-extension-19", "python-extension-20", "python-extension-21", "python-extension-22", "python-extension-23", "python-extension-24", "python-extension-25", "data-extension-18", "data-extension-19", "data-extension-20", "data-extension-21", "data-extension-22", "data-extension-23", "data-extension-24", "data-extension-25"]}, {id: "neo4j-developer", name: "Build with Neo4j and Cypher", requires: ["cypher-create", "cypher-paths", "cypher-aggregation", "neo4j-extension-18", "neo4j-extension-19", "neo4j-extension-20", "neo4j-extension-21", "neo4j-extension-22", "neo4j-extension-23", "neo4j-extension-24", "neo4j-extension-25", "cypher-extension-18", "cypher-extension-19", "cypher-extension-20", "cypher-extension-21", "cypher-extension-22", "cypher-extension-23", "cypher-extension-24", "cypher-extension-25"]}, {id: "graphrag-builder", name: "Build a GraphRAG application", requires: ["neo4j-graphrag", "graphrag-extension-18", "graphrag-extension-19", "graphrag-extension-20", "graphrag-extension-21", "graphrag-extension-22", "graphrag-extension-23", "graphrag-extension-24", "graphrag-extension-25"]}, {id: "ai-agent-builder", name: "Create reliable AI agents", requires: ["agent-evaluation", "agent-extension-18", "agent-extension-19", "agent-extension-20", "agent-extension-21", "agent-extension-22", "agent-extension-23", "agent-extension-24", "agent-extension-25"]}, {id: "graph-data-scientist", name: "Explore data with graphs and Python", requires: ["data-visualization", "graph-rag", "data-extension-18", "data-extension-19", "data-extension-20", "data-extension-21", "data-extension-22", "data-extension-23", "data-extension-24", "data-extension-25", "graphrag-extension-18", "graphrag-extension-19", "graphrag-extension-20", "graphrag-extension-21", "graphrag-extension-22", "graphrag-extension-23", "graphrag-extension-24", "graphrag-extension-25"]}, {id: "german-language-learner", name: "Learn German", requires: ["german-foundations", "german-extension-18", "german-extension-19", "german-extension-20", "german-extension-21", "german-extension-22", "german-extension-23", "german-extension-24", "german-extension-25"]}, {id: "thai-dance-learner", name: "Learn Thai dance", requires: ["thai-dance-foundations", "dance-extension-25", "dance-extension-26", "dance-extension-27", "dance-extension-28", "dance-extension-29", "dance-extension-30", "dance-extension-31", "dance-extension-32", "dance-extension-33", "dance-extension-34", "dance-extension-35"]}, {id: "muay-thai-learner", name: "Learn Thai boxing (Muay Thai)", requires: ["muay-thai-foundations", "muaythai-extension-23", "muaythai-extension-24", "muaythai-extension-25", "muaythai-extension-26", "muaythai-extension-27", "muaythai-extension-28", "muaythai-extension-29", "muaythai-extension-30", "muaythai-extension-31", "muaythai-extension-32"]}, {id: "dance-foundations", name: "Thai dance: Foundations course", requires: ["dance-extension-01", "dance-extension-02", "dance-extension-03", "dance-extension-04", "dance-extension-05", "dance-extension-06", "dance-extension-07", "dance-extension-08", "dance-extension-09", "dance-extension-10", "dance-extension-11", "dance-extension-12"]}, {id: "dance-intermediate", name: "Thai dance: Intermediate course", requires: ["dance-extension-13", "dance-extension-14", "dance-extension-15", "dance-extension-16", "dance-extension-17", "dance-extension-18", "dance-extension-19", "dance-extension-20", "dance-extension-21", "dance-extension-22", "dance-extension-23", "dance-extension-24"]}, {id: "dance-advanced", name: "Thai dance: Advanced course", requires: ["dance-extension-25", "dance-extension-26", "dance-extension-27", "dance-extension-28", "dance-extension-29", "dance-extension-30", "dance-extension-31", "dance-extension-32", "dance-extension-33", "dance-extension-34", "dance-extension-35"]}, {id: "muaythai-foundations", name: "Thai boxing: Foundations course", requires: ["muaythai-extension-01", "muaythai-extension-02", "muaythai-extension-03", "muaythai-extension-04", "muaythai-extension-05", "muaythai-extension-06", "muaythai-extension-07", "muaythai-extension-08", "muaythai-extension-09", "muaythai-extension-10", "muaythai-extension-11"]}, {id: "muaythai-intermediate", name: "Thai boxing: Intermediate course", requires: ["muaythai-extension-12", "muaythai-extension-13", "muaythai-extension-14", "muaythai-extension-15", "muaythai-extension-16", "muaythai-extension-17", "muaythai-extension-18", "muaythai-extension-19", "muaythai-extension-20", "muaythai-extension-21", "muaythai-extension-22"]}, {id: "muaythai-advanced", name: "Thai boxing: Advanced course", requires: ["muaythai-extension-23", "muaythai-extension-24", "muaythai-extension-25", "muaythai-extension-26", "muaythai-extension-27", "muaythai-extension-28", "muaythai-extension-29", "muaythai-extension-30", "muaythai-extension-31", "muaythai-extension-32"]}] AS row
  MERGE (g:LearningGoal {id: row.id, app: 'learnpath-ai'})
  SET g.name=row.name
  WITH g, row
  UNWIND row.requires AS conceptId
  MATCH (c:Concept {id: conceptId, app: 'learnpath-ai'})
  MERGE (g)-[:REQUIRES]->(c)
  RETURN count(*) AS goalRequirementsProcessed
}
RETURN conceptsProcessed, oldPrerequisiteLinksRemoved, oldGoalLinksRemoved, prerequisiteLinksProcessed, goalRequirementsProcessed;
