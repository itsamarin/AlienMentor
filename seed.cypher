// AlienMentor 265-concept curriculum seed for Neo4j Aura Query.
// Three course tiers with a compact prerequisite graph.
// Re-running refreshes only app-owned prerequisite and goal requirement links.
CALL () {
  UNWIND [{id: "python-basics", name: "Python basics", domain: "Python", level: 1, description: "Variables, expressions, and control flow form the foundation for data work.", resourceUrl: "https://docs.python.org/3/tutorial/", resourceTitle: "Python Tutorial"}, {id: "python-functions", name: "Functions and modules", domain: "Python", level: 2, description: "Functions package reusable logic and modules help organize a project.", resourceUrl: "https://docs.python.org/3/tutorial/", resourceTitle: "Python Tutorial"}, {id: "python-collections", name: "Lists and dictionaries", domain: "Python", level: 2, description: "Choose a collection that matches the way your data will be accessed.", resourceUrl: "https://docs.python.org/3/tutorial/", resourceTitle: "Python Tutorial"}, {id: "python-data", name: "Working with tabular data", domain: "Data science", level: 3, description: "Structured rows and columns make real-world datasets easier to inspect and transform.", resourceUrl: "https://pandas.pydata.org/docs/getting_started/intro_tutorials/", resourceTitle: "pandas Getting Started"}, {id: "statistics", name: "Descriptive statistics", domain: "Data science", level: 3, description: "Summaries such as mean and median help describe a dataset before modeling.", resourceUrl: "https://pandas.pydata.org/docs/getting_started/intro_tutorials/", resourceTitle: "pandas Getting Started"}, {id: "data-visualization", name: "Data visualization", domain: "Data science", level: 3, description: "A suitable chart can reveal trends, outliers, and comparisons.", resourceUrl: "https://pandas.pydata.org/docs/getting_started/intro_tutorials/", resourceTitle: "pandas Getting Started"}, {id: "ml-basics", name: "Machine learning foundations", domain: "Data science", level: 4, description: "A model learns patterns from examples and is evaluated on data it did not train on.", resourceUrl: "https://pandas.pydata.org/docs/getting_started/intro_tutorials/", resourceTitle: "pandas Getting Started"}, {id: "neo4j-modeling", name: "Graph modeling with Neo4j", domain: "Neo4j", level: 2, description: "Modeling entities as nodes and named relationships makes connections explicit.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "cypher-match", name: "Cypher MATCH and RETURN", domain: "Cypher", level: 3, description: "MATCH finds graph patterns; RETURN shapes the result sent to the client.", resourceUrl: "https://neo4j.com/docs/cypher-manual/current/", resourceTitle: "Cypher Manual"}, {id: "cypher-create", name: "Cypher CREATE and MERGE", domain: "Cypher", level: 3, description: "CREATE adds new patterns; MERGE matches or creates a pattern idempotently.", resourceUrl: "https://neo4j.com/docs/cypher-manual/current/", resourceTitle: "Cypher Manual"}, {id: "cypher-paths", name: "Paths and variable-length patterns", domain: "Cypher", level: 4, description: "Path patterns let you traverse multiple relationship hops.", resourceUrl: "https://neo4j.com/docs/cypher-manual/current/", resourceTitle: "Cypher Manual"}, {id: "cypher-aggregation", name: "Cypher aggregation", domain: "Cypher", level: 4, description: "Aggregation turns many matched rows into useful summaries.", resourceUrl: "https://neo4j.com/docs/cypher-manual/current/", resourceTitle: "Cypher Manual"}, {id: "vector-search", name: "Embeddings and vector search", domain: "GraphRAG", level: 4, description: "Embeddings represent text as vectors that can be compared for semantic similarity.", resourceUrl: "https://neo4j.com/docs/neo4j-graphrag-python/current/", resourceTitle: "Neo4j GraphRAG resources"}, {id: "retrieval", name: "Retrieval-augmented generation", domain: "GraphRAG", level: 5, description: "Retrieval provides relevant evidence to a language model before it answers.", resourceUrl: "https://neo4j.com/docs/neo4j-graphrag-python/current/", resourceTitle: "Neo4j GraphRAG resources"}, {id: "graph-rag", name: "GraphRAG context building", domain: "GraphRAG", level: 5, description: "Graph structure adds connected entities and relationships to retrieved context.", resourceUrl: "https://neo4j.com/docs/neo4j-graphrag-python/current/", resourceTitle: "Neo4j GraphRAG resources"}, {id: "llm-basics", name: "Language model prompting", domain: "AI agents", level: 4, description: "Clear instructions and structured context make model behavior easier to guide.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "tool-calling", name: "LLM tool calling", domain: "AI agents", level: 5, description: "Tool calling lets a model request a defined operation through application code.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "agent-loops", name: "Agent loops and state", domain: "AI agents", level: 5, description: "An agent loop coordinates observation, action, and stopping conditions.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "agent-evaluation", name: "Evaluating AI agents", domain: "AI agents", level: 6, description: "Evaluation checks whether an agent completes tasks reliably and safely.", resourceUrl: "https://graphacademy.neo4j.com/", resourceTitle: "Neo4j GraphAcademy"}, {id: "neo4j-graphrag", name: "Neo4j GraphRAG workflows", domain: "GraphRAG", level: 6, description: "A graph-backed retrieval workflow combines semantic retrieval with graph context.", resourceUrl: "https://neo4j.com/docs/neo4j-graphrag-python/current/", resourceTitle: "Neo4j GraphRAG resources"}, {id: "german-foundations", name: "German language foundations", domain: "German language", level: 1, description: "Start with everyday greetings, useful phrases, and beginner listening practice.", resourceUrl: "https://www.goethe.de/ins/de/en/kur/ueb.html", resourceTitle: "Goethe-Institut free German practice"}, {id: "thai-dance-foundations", name: "Thai dance foundations", domain: "Thai dance", level: 1, description: "Explore Thai classical dance through posture, hand gestures, rhythm, and cultural context.", resourceUrl: "https://thailandfoundation.or.th/rakram-ep-5-central-thai-dance/", resourceTitle: "Thailand Foundation: Rakram Thai Dance Course"}, {id: "muay-thai-foundations", name: "Muay Thai foundations", domain: "Thai boxing", level: 1, description: "Learn Muay Thai's history, stance, guard, and movement through structured instruction.", resourceUrl: "https://muaythai.sport/about-muaythai/muaythai-rules/", resourceTitle: "IFMA: Muaythai Rules and Disciplines"}, {id: "python-extension-01", name: "Numeric types and conversion", domain: "Python", level: 2, description: "Choose numeric types deliberately and convert values before calculations.", resourceUrl: "https://docs.python.org/3/tutorial/", resourceTitle: "Python Tutorial"}, {id: "python-extension-02", name: "String operations", domain: "Python", level: 2, description: "Inspect, combine, and transform text with Python string operations.", resourceUrl: "https://docs.python.org/3/tutorial/", resourceTitle: "Python Tutorial"}, {id: "python-extension-03", name: "String formatting", domain: "Python", level: 2, description: "Format values into readable output with f-strings and format specifications.", resourceUrl: "https://docs.python.org/3/tutorial/", resourceTitle: "Python Tutorial"}, {id: "python-extension-04", name: "Boolean logic", domain: "Python", level: 2, description: "Combine comparisons with boolean operators to express clear conditions.", resourceUrl: "https://docs.python.org/3/tutorial/", resourceTitle: "Python Tutorial"}, {id: "python-extension-05", name: "Conditional branching", domain: "Python", level: 2, description: "Use if, elif, and else to select behavior from program state.", resourceUrl: "https://docs.python.org/3/tutorial/", resourceTitle: "Python Tutorial"}, {id: "python-extension-06", name: "For loops and iteration", domain: "Python", level: 2, description: "Iterate over collections and use each value without manual indexing.", resourceUrl: "https://docs.python.org/3/tutorial/", resourceTitle: "Python Tutorial"}, {id: "python-extension-07", name: "While loops", domain: "Python", level: 2, description: "Repeat work while a condition holds and define a clear stopping condition.", resourceUrl: "https://docs.python.org/3/tutorial/", resourceTitle: "Python Tutorial"}, {id: "python-extension-08", name: "Comprehensions", domain: "Python", level: 2, description: "Build a transformed list or dictionary concisely from an iterable.", resourceUrl: "https://docs.python.org/3/tutorial/", resourceTitle: "Python Tutorial"}, {id: "python-extension-09", name: "Function arguments", domain: "Python", level: 2, description: "Use positional, keyword, default, and variadic arguments intentionally.", resourceUrl: "https://docs.python.org/3/tutorial/", resourceTitle: "Python Tutorial"}, {id: "python-extension-10", name: "Return values and scope", domain: "Python", level: 4, description: "Return results explicitly and understand where names are available.", resourceUrl: "https://docs.python.org/3/tutorial/", resourceTitle: "Python Tutorial"}, {id: "python-extension-11", name: "Modules and imports", domain: "Python", level: 4, description: "Split reusable code into modules and import only what a program needs.", resourceUrl: "https://docs.python.org/3/tutorial/", resourceTitle: "Python Tutorial"}, {id: "python-extension-12", name: "Exceptions and error handling", domain: "Python", level: 4, description: "Catch expected failures specifically and preserve useful error context.", resourceUrl: "https://docs.python.org/3/tutorial/", resourceTitle: "Python Tutorial"}, {id: "python-extension-13", name: "Reading and writing files", domain: "Python", level: 4, description: "Open files with context managers and choose an appropriate text encoding.", resourceUrl: "https://docs.python.org/3/tutorial/", resourceTitle: "Python Tutorial"}, {id: "python-extension-14", name: "Working with JSON", domain: "Python", level: 4, description: "Serialize and parse JSON while validating the expected data shape.", resourceUrl: "https://docs.python.org/3/tutorial/", resourceTitle: "Python Tutorial"}, {id: "python-extension-15", name: "Working with CSV", domain: "Python", level: 4, description: "Read and write tabular text while handling headers and missing values.", resourceUrl: "https://docs.python.org/3/tutorial/", resourceTitle: "Python Tutorial"}, {id: "python-extension-16", name: "Virtual environments", domain: "Python", level: 4, description: "Isolate project dependencies so installations do not conflict across projects.", resourceUrl: "https://docs.python.org/3/tutorial/", resourceTitle: "Python Tutorial"}, {id: "python-extension-17", name: "Packages and dependency files", domain: "Python", level: 4, description: "Declare and install repeatable dependencies for a Python project.", resourceUrl: "https://docs.python.org/3/tutorial/", resourceTitle: "Python Tutorial"}, {id: "python-extension-18", name: "Type hints", domain: "Python", level: 6, description: "Add type annotations to make function contracts easier to understand and check.", resourceUrl: "https://docs.python.org/3/tutorial/", resourceTitle: "Python Tutorial"}, {id: "python-extension-19", name: "Unit testing", domain: "Python", level: 6, description: "Write small repeatable tests for expected behavior and important edge cases.", resourceUrl: "https://docs.python.org/3/tutorial/", resourceTitle: "Python Tutorial"}, {id: "python-extension-20", name: "Debugging and logging", domain: "Python", level: 6, description: "Reproduce a failure, inspect state, and use structured logs to narrow its cause.", resourceUrl: "https://docs.python.org/3/tutorial/", resourceTitle: "Python Tutorial"}, {id: "python-extension-21", name: "Decorators and reusable wrappers", domain: "Python", level: 6, description: "Use a decorator to add a focused behavior around a function.", resourceUrl: "https://docs.python.org/3/tutorial/", resourceTitle: "Python Tutorial"}, {id: "pyth